# Supabase project URL and keys. For the local stack, `npx supabase status -o env`
# prints them as API_URL, PUBLISHABLE_KEY and SECRET_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_SECRET_KEY=sb_secret_example

# Shared secret the ESP32 sends in the X-Scale-Token header.
# Generate one with: openssl rand -hex 32
SCALE_INGEST_TOKEN=example-scale-token

# Bearer token for the MCP endpoint at /api/mcp, sent as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
MCP_TOKEN=example-mcp-token
